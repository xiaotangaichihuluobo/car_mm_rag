# ==================== 环境变量配置(示例模板) ====================
# 用法: 复制本文件为 `.env`(被 .gitignore 忽略, 不会上传), 填上你的密钥。
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# 注意: 本文件仅作占位示例, 真实密钥只写在本地 .env, 严禁提交到版本库。

# ---- DashScope (阿里云百炼) - 千问大模型, 模型多、质量高 ----
# 从 https://dashscope.console.aliyun.com/ 创建 API Key(开头 sk-)。
# RAGAS 评估 / qwen-vl 生成 / 检索都用它(走 OpenAI 兼容接口)。
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# qwen-vl 读页图作答用的视觉模型(带 -latest 后缀的 id 会 403, 别用)
DASHSCOPE_VL_MODEL=qwen-vl-max

# ---- 可选: 用 DeepSeek 替代 DashScope 做日常推理(便宜) ----
# 不用可留空或删掉; ragas_eval.py 默认走 DASHSCOPE_*, 想切 DeepSeek 需改 Config.LLM_PROVIDER。
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 可选: 覆盖 Milvus / MySQL / Redis 连接(不设则读 config.ini) ----
# MILVUS_HOST=localhost
# MILVUS_PORT=19538